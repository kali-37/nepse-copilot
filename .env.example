# NEPSE Trader — environment template.
#
# Copy to `.env` (git-ignored), run `chmod 600 .env`, and fill in what you need. Every value here is
# optional: with an empty .env the tool runs in fully deterministic, offline-
# capable mode. All settings are also overridable as real environment
# variables with the same NEPSE_ prefix.

# ---------------------------------------------------------------- core paths
# NEPSE_DB_PATH=data/nepse.db
# NEPSE_RAW_CACHE_DIR=data/raw
# NEPSE_LOG_DIR=logs

# ------------------------------------------------------------------- ingest
# Which sources to pull. Use "all" to construct every known client.
# NEPSE_ENABLED_SOURCES=sharesansar,chukul,nepse_official
# NEPSE_MIN_REQUEST_INTERVAL=1.5
# NEPSE_FETCH_ENGINE=httpx          # httpx | scrapling
# NEPSE_PARSE_ENGINE=auto           # auto | scrapling | selectolax

# ---------------------------------------------------------------- run modes
# normal = deterministic only (zero tokens). ai = adds LLM narrative on top.
# NEPSE_ANALYSIS_MODE=normal
# online=false forbids ALL network calls (ingest, web retrieval, live LLM).
# NEPSE_ONLINE=true
# Symbols the advisor reads when none are passed explicitly.
# NEPSE_WATCHLIST=NABIL,ADBL,HDL,NICA
# NEPSE_ADVISOR_MAX_SYMBOLS=25

# --------------------------------------------------------------------- LLM
# Provider chains, tried in order. Names: claude_cli | anthropic | openrouter
# NEPSE_LLM_BULK_PROVIDERS=openrouter,claude_cli
# NEPSE_LLM_SYNTHESIS_PROVIDERS=claude_cli,anthropic,openrouter

# claude_cli shells out to your local Claude Code CLI, so AI mode costs no
# API money — it runs under the subscription you already have.
# NEPSE_CLAUDE_CLI_PATH=claude
# NEPSE_CLAUDE_CLI_MODEL=

# Free OpenRouter models handle the bulk per-symbol passes.
# Get a key at https://openrouter.ai/keys
# NEPSE_OPENROUTER_API_KEY=
# NEPSE_OPENROUTER_MODELS=meta-llama/llama-3.3-70b-instruct:free,qwen/qwen-2.5-72b-instruct:free

# Direct Anthropic API — only used if you put "anthropic" in a provider chain.
# NEPSE_ANTHROPIC_API_KEY=
# NEPSE_ANTHROPIC_MODEL=claude-opus-5

# ---------------------------------------------------------- token budgeting
# Hard ceilings. On exhaustion the advisor degrades to normal mode with a
# banner — it never errors out and never invents numbers.
# NEPSE_LLM_MAX_CALLS_PER_DAY=40
# NEPSE_LLM_MAX_TOKENS_PER_DAY=400000
# NEPSE_LLM_MAX_DEEP_PASSES_PER_WEEK=2
# NEPSE_LLM_CACHE_TTL_HOURS=168

# --------------------------------------------------------------------- RAG
# NEPSE_RAG_MAX_DOCUMENTS=8
# NEPSE_RAG_MAX_EVIDENCE_CHARS=12000
# NEPSE_RAG_ENABLE_WEB=true

# --------------------------------------------------------------- MeroShare
# READ-ONLY access to YOUR OWN CDSC/MeroShare account: holdings, WACC and
# transaction history. It does NOT apply for IPOs (ASBA) and cannot place
# orders. Credentials are never logged and never written to the database.
#
# Note: this is automated access to a login-gated portal. It is your own data,
# but CDSC's terms of service may not permit automation — that is your call to
# make. `meroshare import` accepts a CSV/paste export if you'd rather not
# store credentials at all.
# NEPSE_MEROSHARE_ENABLED=false
# NEPSE_MEROSHARE_DP_ID=               # your DP's ID, from your own account
# NEPSE_MEROSHARE_USERNAME=
# NEPSE_MEROSHARE_PASSWORD=
# Prefer the OS keyring over a plaintext password in this file:
# NEPSE_MEROSHARE_USE_KEYRING=true
# NEPSE_MEROSHARE_KEYRING_SERVICE=nepse-trader-meroshare

# Never use VITE_* variables for credentials: Vite exposes them to browsers.
# Never commit .env, account exports, database backups or HAR captures.
# A public GitHub repository shares code; every user keeps a separate local
# .env and SQLite database. The dashboard is a personal, single-user app.
