.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/
data/*.db
# WAL sidecars: present whenever a connection is open, gone on clean close.
data/*.db-wal
data/*.db-shm
data/*.sqlite3
har/captures/*.har
!har/captures/.gitkeep
*.log
# Runtime run-logs: keep the tree, ignore the files.
logs/**/*.log
!logs/.gitkeep
.env
dist/
build/
.build_workflow.js
.review_workflow.js
web/dist

# graphify: track the graph and report; ignore regenerable bulk.
graphify-out/cache/
graphify-out/graph.html
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
graphify-out/.graphify_analysis.json
# Stray per-package graph caches (regenerable, not the project graph).
nepse_trader/**/graphify-out/
